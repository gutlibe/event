#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Database;
use App\Models\Event;
use App\Reference;
use App\Services\RegistrationService;

require dirname(__DIR__).'/app/bootstrap.php';

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        migrate();
        echo "Schema applied to ".env('DB_DATABASE').".\n";
        break;

    case 'seed':
        seed();
        break;

    case 'fresh':
        if (! in_array('--force', $argv, true)) {
            echo "This drops the app's tables in ".env('DB_DATABASE').". Re-run with --force if you mean it.\n";
            exit(1);
        }

        Database::execute('SET FOREIGN_KEY_CHECKS = 0');

        foreach (['registrations', 'events', 'password_resets', 'rate_limits', 'users'] as $table) {
            Database::execute('DROP TABLE IF EXISTS '.$table);
        }

        Database::execute('SET FOREIGN_KEY_CHECKS = 1');
        seed();
        break;

    case 'send-reminders':
        $sent = RegistrationService::sendDueReminders();
        echo "Queued {$sent} reminder email(s).\n";
        break;

    case 'status':
        $counts = [
            'organizers' => Database::value('SELECT COUNT(*) FROM users'),
            'events' => Database::value('SELECT COUNT(*) FROM events'),
            'registrations' => Database::value('SELECT COUNT(*) FROM registrations'),
        ];

        foreach ($counts as $label => $value) {
            echo str_pad($label, 16).$value."\n";
        }
        break;

    default:
        echo <<<TXT
        Gather console

          php bin/console migrate           apply the database schema
          php bin/console seed              create demo organizer, events and guests
          php bin/console fresh --force     drop app tables, migrate and seed again
          php bin/console send-reminders    email T-24h reminders (log mailer locally)
          php bin/console status            quick row counts

        TXT;
        exit($command === 'help' ? 0 : 1);
}

function migrate(): void
{
    $sql = (string) file_get_contents(base_path('database/schema.sql'));

    foreach (explode(';', $sql) as $statement) {
        $statement = trim($statement);

        if ($statement === '') {
            continue;
        }

        Database::pdo()->exec($statement);
    }
}

